# .env.example — infra/worker-vm/.env 로 복사 후 채울 것. repo 에 커밋 금지.
# ops-vm 의 AIRFLOW__EDGE__JWT_SECRET, AIRFLOW__CORE__FERNET_KEY 와 동일한 값 사용.

AIRFLOW__CORE__LOAD_EXAMPLES=False

# ops-vm api-server 주소 (Tailscale 직결, Caddy 경유 아님)
AIRFLOW__EDGE__API_URL=http://<oci-ops-tailnet-ip>:8080
AIRFLOW__EDGE__JWT_SECRET=<ops-vm 과 동일한 값>

AIRFLOW__CORE__FERNET_KEY=<ops-vm 과 동일한 값>
