# .env.example — infra/ops-vm/.env 로 복사 후 채울 것. repo 에 커밋 금지.

# Caddy — 공인 도메인 (예: airflow.example.com)
AIRFLOW_DOMAIN=airflow.<your-domain>

# api-server 호스트 포트 바인드용 (defense-in-depth: 공인 IP 의 8080 닫힘, tailnet 만 받음)
OPS_TAILNET_IP=<oci-ops-tailnet-ip>

# Postgres
POSTGRES_PASSWORD=<openssl rand -hex 16>

# DB 연결 — POSTGRES_PASSWORD 값을 그대로 입력
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:<POSTGRES_PASSWORD>@postgres:5432/airflow

# Core
AIRFLOW__CORE__EXECUTOR=airflow.providers.edge3.executors.EdgeExecutor
AIRFLOW__CORE__FERNET_KEY=<python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Auth
AIRFLOW__CORE__AUTH_MANAGER=airflow.api_fastapi.auth.managers.simple.simple_auth_manager.SimpleAuthManager
AIRFLOW__SIMPLE_AUTH_MANAGER__USERS=admin

# Session 서명 키 (Airflow 3: [webserver] → [api] 로 이동)
AIRFLOW__API__SECRET_KEY=<openssl rand -hex 32>

# Edge Executor — 워커가 Tailscale 직결로 쓰는 api-server 주소 (Caddy 경유 아님)
AIRFLOW__EDGE__API_URL=http://<oci-ops-tailnet-ip>:8080/edge_worker/v1/rpcapi
AIRFLOW__EDGE__API_ENABLED=True

# JWT — edge worker 인증 (api_auth 섹션, AIRFLOW__EDGE__JWT_SECRET 아님)
AIRFLOW__API_AUTH__JWT_SECRET=<openssl rand -hex 32>

# DAG 배포 = GitDagBundle. dag-processor·워커가 repo 에서 dags/ 직접 fetch (git push 가 곧 배포).
# public repo 라 자격증명 불필요 — repo_url 직접 (git_conn_id 생략). repo_url 은 실제 값으로.
AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST=[{"name":"airflow-stack","classpath":"airflow.providers.git.bundles.git.GitDagBundle","kwargs":{"repo_url":"https://github.com/<your-repo>/airflow-stack.git","tracking_ref":"main","subdir":"dags","refresh_interval":60}}]

# DooD — ops 워커가 host docker.sock 접근 (registry GC / build cache prune 전용).
# ops 큐 = privileged 인프라 유지보수 전용으로 고정 — 일반 워크로드 라우팅 금지.
# 찾기: getent group docker | cut -d: -f3
DOCKER_GID=<host docker group gid>

# 메트릭 — nexus-prime statsd-exporter(9125/UDP, nexus network)로 송신 → prometheus scrape.
# influxdb_enabled=True: edge_worker.* 등 태그 메트릭을 라벨로 보존 (statsd-exporter 가 파싱).
AIRFLOW__METRICS__STATSD_ON=True
AIRFLOW__METRICS__STATSD_HOST=statsd-exporter
AIRFLOW__METRICS__STATSD_PORT=9125
AIRFLOW__METRICS__STATSD_PREFIX=airflow
AIRFLOW__METRICS__STATSD_INFLUXDB_ENABLED=True

# DAG run 실패 알람 (dags/lib/alert.py) — scheduler/dag-processor 에서 os.environ 으로 읽음
DISCORD_WEBHOOK_URL=<discord webhook url>

# daily_claude_ping DAG — mac-server 로 SSH 하여 claude 실행. ops-vm edge-worker 에서 os.environ 으로 읽음
# mac-server authorized_keys 에 forced command 로 등록된 전용 키 (claude ping 외 실행 불가)
CLAUDE_SSH_HOST=<MAC_TAILNET_IP>
CLAUDE_SSH_USER=<mac-server 사용자명>
CLAUDE_SSH_KEY_B64=<base64 -w0 < ~/.ssh/airflow_claude_ping (mac-server 에서 생성한 개인키)>
