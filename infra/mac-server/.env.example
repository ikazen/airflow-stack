# .env.example — infra/mac-server/.env 로 복사 후 채울 것. repo 에 커밋 금지.
# ops-vm 의 AIRFLOW__API_AUTH__JWT_SECRET, AIRFLOW__CORE__FERNET_KEY 와 동일한 값 사용.

AIRFLOW__CORE__LOAD_EXAMPLES=False

# ops-vm api-server 주소 (Tailscale 직결, Caddy 경유 아님)
AIRFLOW__EDGE__API_URL=http://<oci-ops-tailnet-ip>:8080/edge_worker/v1/rpcapi
AIRFLOW__API_AUTH__JWT_SECRET=<ops-vm 과 동일한 값>

AIRFLOW__CORE__FERNET_KEY=<ops-vm 과 동일한 값>

# DooD — Colima VM 의 docker 소켓 그룹 gid (@task.docker 워크로드용).
# 찾기: `colima ssh -- getent group docker | cut -d: -f3`
DOCKER_GID=<colima docker group gid>

# DAG 배포 = GitDagBundle. 워커가 task 실행 시 repo 에서 dags/ fetch. ops-vm 과 동일 값.
# public repo 라 자격증명 불필요. repo_url 은 실제 값으로.
AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST=[{"name":"airflow-stack","classpath":"airflow.providers.git.bundles.git.GitDagBundle","kwargs":{"repo_url":"https://github.com/<your-repo>/airflow-stack.git","tracking_ref":"main","subdir":"dags","refresh_interval":60}}]
